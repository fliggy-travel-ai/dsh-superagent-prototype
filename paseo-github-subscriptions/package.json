{
  "name": "paseo-github-subscriptions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "icons/",
    "browser-extension/",
    "scripts/proximity-away.py"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/resolve-js-to-ts.mjs --experimental-strip-types --test --test-timeout=60000 tests/*.test.ts",
    "check": "npm run typecheck && npm run boundaries && npm test && npm run scan",
    "boundaries": "node --experimental-strip-types scripts/check-plugin-boundaries.ts",
    "check:paseo": "node scripts/check-paseo-load.mjs",
    "vendor:check": "node --experimental-strip-types scripts/vendor-sync.ts --check",
    "test:daemon": "node --experimental-strip-types tests/daemon-integration.ts",
    "scan": "node --experimental-strip-types scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.0",
    "@getpaseo/plugin": "0.15.0",
    "@getpaseo/protocol": "0.15.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3"
  }
}
